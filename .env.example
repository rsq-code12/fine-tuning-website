# ─── Growth engine configuration ──────────────────────────────────────────────
# Copy to .env.local for development, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Everything is optional: the site works with none of these, each one switches a capability on.

# Search visibility. Leave unset to keep the whole site out of Google, Bing and AI crawlers
# (robots.txt blocks everything + noindex). Set to 1 and redeploy once the real brand is live.
SITE_INDEXABLE=

# TODO(brand): previous domain. Do not invent a Ramanujan domain.
# Set this to the real origin once it exists (canonical URLs, sitemap, llms.txt, OG cards, IndexNow).
NEXT_PUBLIC_SITE_URL=https://weightcraft.ai

# Where hot leads and the daily lead-radar digest go. Use either or both.
#   Slack:   Apps → Incoming Webhooks → copy URL
#   Discord: Channel settings → Integrations → Webhooks → copy URL
#   Zapier / Make / n8n: a "catch hook" URL, to push leads into a CRM or Google Sheet
LEAD_WEBHOOK_URL=
#   Email via Resend (resend.com, free tier is plenty)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# A sender on a domain verified in Resend, e.g. "Ramanujan <team@your-domain>".
# TODO(brand): the public contact address lives only in SITE.email (lib/site.ts) and is still hello@weightcraft.ai.
RESEND_FROM=
# 1 = instantly email every lead a confirmation (needs RESEND_FROM on a verified domain)
LEAD_AUTOREPLY=0

# Claude: researches every lead, drafts your reply, ranks radar posts by real buying intent.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Protects the cron endpoints. Vercel sends it automatically to cron jobs. Any long random string.
CRON_SECRET=

# Lead radar sources beyond Hacker News (both free):
#   Reddit: reddit.com/prefs/apps → "create app" → type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#   Bluesky: Settings → Privacy and security → App passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# How far back each daily run looks (hours)
RADAR_LOOKBACK_HOURS=26

# Search console ownership (paste only the content="..." value)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: fixed IndexNow key (otherwise derived from the domain)
INDEXNOW_KEY=
