{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "weightcraft-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "weightcraft-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "weightcraft-dev-attach",
      "url": "http://localhost:3001",
      "port": 3001
    }
  ]
}
